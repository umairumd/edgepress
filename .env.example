# ============================================================
# REQUIRED — WordPress / WPGraphQL
# ============================================================

# Full URL to your WPGraphQL endpoint
WP_GRAPHQL_ENDPOINT=https://your-cms-domain.com/graphql

# Domain(s) where WordPress media is hosted
# Comma-separated if multiple: cms1.example.com,cdn.example.com
WP_MEDIA_DOMAIN=your-cms-domain.com

# Canonical site origin (used for sitemaps and metadata)
SITE_URL=https://your-domain.com

# ============================================================
# REQUIRED — Contact Form
# ============================================================

# Resend API key (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=info@yourdomain.com

# Sender name and address shown in contact emails
CONTACT_FROM_EMAIL=Your Agency <noreply@yourdomain.com>

# ============================================================
# REQUIRED — Analytics
# ============================================================

# Google Tag Manager container ID
GTM_ID=GTM-XXXXXXX

# ============================================================
# OPTIONAL — WordPress field name overrides
# Only needed if your WP setup uses non-default ACF field names
# ============================================================

# WP_PORTFOLIO_TAX_FIELD=
# WP_PORTFOLIO_ENTRY_FIELD=
# WP_PORTFOLIO_ACF_GROUP_FIELD=
# WP_PORTFOLIO_FEATURE_FIELD=
# WP_POST_ACF_GROUP_FIELD=
# WP_POST_FEATURE_FIELD=

# ============================================================
# OPTIONAL — Google Drive / OAuth
# Only needed if Google Drive integration is enabled
# ============================================================

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# ============================================================
# OPTIONAL — Supabase
# Only needed if Supabase features are enabled
# ============================================================

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
